# Supabase Project Credentials (Frontend uses public Anon Key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Modular Mock Toggles (default is false = use real database)
VITE_USE_MOCKS_AUTH=false
VITE_USE_MOCKS_PROFILES=false
VITE_USE_MOCKS_PORTFOLIO=false
VITE_USE_MOCKS_CREDENTIALS=false

# Backend / Local Seeds only (NEVER expose to frontend bundles)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-local-scripts
